        ELSEIF bFIFOOpz1Prog2=TRUE THEN

            CalcVolPMR("Vol_HUR_AP_BC0_Door_Ext");

            CalcVolPMR("Vol_HUR_AP_BC0_RBumper");

            CalcVolPMR("Vol_HUR_BC0_Rearfend_Ext");

