    PROC Volume_HURACAN_BC0_R12_EXT()
        nVolume:=0;
        nVolumeCalc:=0;
        SetTmSignal "goVolumeCalcpreFIFO",0,0.1;
        BrushTableNo:=(nProgramnum*1000)+nMaterialnum;
        WaitTime 0.2;
        !Checking if files is presence in the Brush folder
        BrushPath:=HOME_ROOT+BRUSH_DIR+"Table"+NumToStr(BrushTableNo,0)+bt;
        sizebrush:=FileSize(BrushPath);

        CalcVolPMR("Vol_HUR_BC0_HO1_Ext");
        PntMAPlog " Vol_HUR_BC0_HO1_Ext "" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";

        CalcVolPMR("Vol_HUR_BC0_HO2_Ext");
        PntMAPlog " Vol_HUR_BC0_HO1_Ext "" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";

        CalcVolPMR("Vol_HUR_BC0_Roof1_Ext");
        PntMAPlog " Vol_HUR_BC0_Roof1_Ext "" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";

        CalcVolPMR("Vol_HUR_BC0_Roof2_Ext");
        PntMAPlog " Vol_HUR_BC0_Roof2_Ext "" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";

        IF bFIFOOpz1Prog2=TRUE THEN

            CalcVolPMR("Vol_HUR_AP_BC0_Rearbonnet");
            PntMAPlog " Vol_HUR_AP_BC0_Rearbonnet "" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";

            CalcVolPMR("Vol_HUR_AP_BC0_SpoilerUP");
            PntMAPlog " Vol_HUR_AP_BC0_SpoilerUP "" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";

            CalcVolPMR("Vol_HUR_AP_BC0_FBumber1");
            PntMAPlog " Vol_HUR_AP_BC0_FBumber1"" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";

            CalcVolPMR("Vol_HUR_AP_BC0_FBumber2");
            PntMAPlog " Vol_HUR_AP_BC0_FBumber2"" Skid: "+NumToStr(nJobIDnum,0)+" Cal Vol: "+NumToStr(nVolumeCalc,0)+".";
        ENDIF
        !
        IF bFIFOOpz1Prog4=TRUE THEN

            CalcVolPMR("Vol_HUR_CFK_BC0_Rearbonnet");

            CalcVolPMR("Vol_HUR_CFK_BC0_SpoilerUP");

        ENDIF
        !
        WaitTime 0.2;
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=650;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

