MODULE CalculationVol(SYSMODULE)
    !
    VAR num SafeAmmount;
    VAR intnum irErrInJob;
    VAR intnum irStopGunBellCleaner;
    VAR intnum irProgramInfo;
    CONST string NDX_FILE:="segments.ndx";
    CONST string PROGRAMS_DIR:="programs/";
    CONST string BTRACK_DIR:="btrack/";
    CONST string BRUSH_DIR:="ipsdata/node1/A1Brush/";
    PERS bool bDefaultVol:=FALSE;

    VAR num RobID:=12;
    VAR num nCycleTime;
    VAR clock clkCycleTime;
    VAR string stRobotName;
    VAR string stValves;

    VAR num nProgramnum;
    VAR num nMaterialnum;
    VAR num nJobIDnum;
    VAR num nProgOpz1num;
    VAR num nProgOpz2num;
    VAR num nProgOpz3num;
    VAR num nLastJobIDnum;
    VAR num nLastPrognum;
    VAR string sModelndx{1};
    VAR string stModNameCalc;
    VAR num nVolume;
    VAR num nVolumeCalc;
    VAR num VolEst;
    VAR num BrushTableNo;
    VAR string FilePath;
    VAR string BrushPath;
    VAR string trk:=".trk";
    VAR string bt:=".bt";
    VAR num size;
    VAR num sizebrush;
    VAR bool errormemory;
    !
    PERS bool bFIFOOpz1Prog1:=FALSE;
    PERS bool bFIFOOpz1Prog2:=TRUE;
    PERS bool bFIFOOpz1Prog3:=FALSE;
    PERS bool bFIFOOpz1Prog4:=FALSE;
    PERS bool bFIFOOpz1Prog5:=FALSE;
    PERS bool bFIFOOpz1Prog6:=FALSE;
    PERS bool bFIFOOpz1Prog7:=FALSE;
    PERS bool bFIFOOpz1Prog8:=FALSE;
    PERS bool bFIFOOpz1Prog9:=FALSE;
    PERS bool bFIFOOpz1Prog10:=FALSE;
    PERS bool bFIFOOpz1Prog11:=FALSE;
    PERS bool bFIFOOpz1Prog12:=FALSE;
    PERS bool bFIFOOpz1Prog13:=FALSE;
    PERS bool bFIFOOpz1Prog14:=FALSE;
    PERS bool bFIFOOpz1Prog15:=TRUE;
    PERS bool bFIFOOpz1Prog16:=FALSE;
    PERS bool bFIFOOpz2Prog1:=FALSE;
    PERS bool bFIFOOpz2Prog2:=FALSE;
    PERS bool bFIFOOpz2Prog3:=FALSE;
    PERS bool bFIFOOpz2Prog4:=FALSE;
    PERS bool bFIFOOpz2Prog5:=FALSE;
    PERS bool bFIFOOpz2Prog6:=FALSE;
    PERS bool bFIFOOpz2Prog7:=FALSE;
    PERS bool bFIFOOpz2Prog8:=FALSE;
    PERS bool bFIFOOpz2Prog9:=FALSE;
    PERS bool bFIFOOpz2Prog10:=FALSE;
    PERS bool bFIFOOpz2Prog11:=FALSE;
    PERS bool bFIFOOpz2Prog12:=FALSE;
    PERS bool bFIFOOpz2Prog13:=FALSE;
    PERS bool bFIFOOpz2Prog14:=FALSE;
    PERS bool bFIFOOpz2Prog15:=FALSE;
    PERS bool bFIFOOpz2Prog16:=FALSE;
    PERS bool bFIFOOpz3Prog1:=FALSE;
    PERS bool bFIFOOpz3Prog2:=FALSE;
    PERS bool bFIFOOpz3Prog3:=FALSE;
    PERS bool bFIFOOpz3Prog4:=FALSE;
    PERS bool bFIFOOpz3Prog5:=FALSE;
    PERS bool bFIFOOpz3Prog6:=FALSE;
    PERS bool bFIFOOpz3Prog7:=FALSE;
    PERS bool bFIFOOpz3Prog8:=FALSE;
    PERS bool bFIFOOpz3Prog9:=FALSE;
    PERS bool bFIFOOpz3Prog10:=FALSE;
    PERS bool bFIFOOpz3Prog11:=FALSE;
    PERS bool bFIFOOpz3Prog12:=FALSE;
    PERS bool bFIFOOpz3Prog13:=FALSE;
    PERS bool bFIFOOpz3Prog14:=FALSE;
    PERS bool bFIFOOpz3Prog15:=FALSE;
    PERS bool bFIFOOpz3Prog16:=FALSE;

    PERS bool bFIFOINT_BONNET:=FALSE;
    PERS bool bFIFOINT_EC:=FALSE;
    PERS bool bFIFOINT_FDL_LEAF:=FALSE;
    PERS bool bFIFOINT_FDL_ENTRY:=FALSE;
    PERS bool bFIFOINT_FDR_LEAF:=FALSE;
    PERS bool bFIFOINT_FDR_ENTRY:=FALSE;
    PERS bool bFIFOINT_RDL_LEAF:=FALSE;
    PERS bool bFIFOINT_RDL_ENTRY:=FALSE;
    PERS bool bFIFOINT_RDR_LEAF:=FALSE;
    PERS bool bFIFOINT_RDR_ENTRY:=FALSE;
    PERS bool bFIFOINT_TAILGATE:=FALSE;
    PERS bool bFIFOINT_FUELCAP:=FALSE;

    PERS bool bFIFOSIDEFINS:=FALSE;
    PERS bool bFIFOFUELCAPS:=FALSE;
    PERS bool bFIFOLHMIRROR:=FALSE;
    PERS bool bFIFODIAPASONS:=FALSE;
    PERS bool bFIFORHMIRROR:=FALSE;
    PERS bool bFIFOFBUMPERUP:=FALSE;
    PERS bool bFIFOARCHES_L:=FALSE;
    PERS bool bFIFORDPANELS:=FALSE;
    PERS bool bFIFOSPOILER:=FALSE;
    PERS bool bFIFORBUMPERUP:=FALSE;

    PERS bool bFIFORHDHANDLES:=FALSE;
    PERS bool bFIFOSPOILERLIP:=FALSE;
    PERS bool bFIFOLOWSPOILER:=FALSE;
    PERS bool bFIFORBUMPERLP:=FALSE;
    PERS bool bFIFOARCHES_R:=FALSE;
    PERS bool bFIFOFDPANELS:=FALSE;
    PERS bool bFIFOFBUMPERLP:=FALSE;
    PERS bool bFIFOLHDHANDLES:=FALSE;
    PERS bool bFIFOANTENNA:=FALSE;
    PERS bool bFIFOSENSORS:=FALSE;
    !Huracan PLA
    PERS bool bFIFO_MIRROR_CAP:=FALSE;
    PERS bool bFIFO_PANEL_UP_B:=FALSE;
    PERS bool bFIFO_PANEL_UP_A:=FALSE;
    PERS bool bFIFO_Handles:=FALSE;
    PERS bool bFIFO_FINISHER:=FALSE;
    PERS bool bFIFO_ROCKER_COVER:=FALSE;
    PERS bool bFIFO_FINISHER_CFK:=FALSE;
    PERS bool bFIFO_ROCKER_COVER_CFK:=FALSE;
    PERS bool bFIFO_FBUMPER:=FALSE;
    PERS bool bFIFO_RBUMPER:=FALSE;
    PERS bool bFIFO_UP_SPOILER:=FALSE;
    PERS bool bFIFO_UP_SPOILER_CFK:=FALSE;
    !
    PERS bool bFIFO_KIDNEY:=FALSE;
    PERS bool bFIFO_PANEL_IN:=FALSE;
    PERS bool bFIFO_Sensor:=FALSE;
    PERS bool bFIFO_CARBONTAIL:=FALSE;
    PERS bool bFIFO_UPPERSP:=FALSE;
    !Second Cartdrige
    PERS bool bCartdrige:=FALSE;

    PROC mainCalculationVol()
        !
        IDelete irErrInJob;
        CONNECT irErrInJob WITH tpirErrInJob;
        ISignalDO RobotError,1,irErrInJob;
        !
        IDelete irErrInJob;
        CONNECT irErrInJob WITH tpirErrInJob;
        ISignalDO SystemRunning,0,irErrInJob;
        !
        IDelete irStopGunBellCleaner;
        CONNECT irStopGunBellCleaner WITH tpStopGunBellCleaner;
        ISignalDO RunChainClosed,0,irStopGunBellCleaner;
        !
        IDelete irStopGunBellCleaner;
        CONNECT irStopGunBellCleaner WITH tpStopGunBellCleaner;
        ISignalDO sdoQuickStop,1,irStopGunBellCleaner;
        !
        IDelete irProgramInfo;
        CONNECT irProgramInfo WITH tpProgramInfo;
        ISignalDO InModule,1,irProgramInfo;
        !
        SafeAmmount:=nSafeCal;
        !
        IF diReqCalcVolPreFIFO=1 THEN
            !IF (giProgNumPreFifo<>nLastPrognum OR giJobIDPreFifo<>nLastJobIDnum OR bEnd1CatridgeBCURUS=TRUE OR bEnd1CatridgePRURUS=TRUE) AND doInModule=0 AND diReqCalcVolPreFIFO=1 THEN
            IF (giProgNumPreFifo<>nLastPrognum OR giJobIDPreFifo<>nLastJobIDnum OR bCartdrige=TRUE) OR
              ((giProgNumPreFifo>0 AND giProgNumPreFifo=nLastPrognum) AND giJobIDPreFifo=nLastJobIDnum) THEN
                errormemory:=FALSE;
                nProgOpz1num:=GetSignal("giOpt1numPreFifo");
                nProgOpz2num:=GetSignal("giOpt2numPreFifo");
                nProgOpz3num:=GetSignal("giOpt3numPreFifo");
                nProgramnum:=GetSignal("giProgNumPreFifo");
                nMaterialnum:=GetSignal("giMaterialNumPreFifo");
                nJobIDnum:=GetSignal("giJobIDPreFifo");
                WaitTime 0.2;
                GetCustOptionsPreFIFO;
                !
                IF giJobIDPreFifo<>nLastJobIDnum THEN
                    bCartdrige:=FALSE;
                    WaitTime 0.3;
                ENDIF
                !
                IF bCartdrige=FALSE THEN

                    IF ((giProgNumPreFifo>0 AND giProgNumPreFifo=nLastPrognum) AND giJobIDPreFifo=nLastJobIDnum) THEN
                        IF giJobIDPreFifo<>0 THEN
                            stModNameCalc:="DEFAULT";
                        ELSE
                            GOTO label;
                        ENDIF
                    ELSE
                        sModelndx{1}:=sModelget(nProgramnum,1);
                        stModNameCalc:=sModelndx{1};
                    ENDIF
                ELSEIF bCartdrige=TRUE THEN
                    !
                    stModNameCalc:=stModNameCalc+"II";
                ENDIF
                WaitTime 0.3;
                !
                TEST stModNameCalc

                CASE "URUS_PA1_BC0_R12_Plastic":
                    Volume_URUS_PA1_BC0_R12_PLA;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=565;
                    bCartdrige:=TRUE;

                CASE "URUS_PA1_BC0_R12_PlasticII":
                    Volume_URUS_PA1_BC0_R12_PLAII;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=500;
                    bCartdrige:=FALSE;

                CASE "URUS_PA1_BC0_INT":
                    Volume_URUS_PA1_BC0_INT;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=550;

                CASE "URUS_PA1_BC0_R12_EXT":
                    Volume_URUS_PA1_BC0_R12_EXT;
                    CalcVolLog;
                    bCartdrige:=TRUE;
                    IF bDefaultVol=TRUE nVolume:=550;

                CASE "URUS_PA1_BC0_R12_EXTII":
                    Volume_URUS_PA1_BC0_R12_EXTII;
                    bCartdrige:=FALSE;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=520;

                CASE "URUS_PA1_PR0_INT":
                    Volume_URUS_PA1_PR0_INT;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=520;

                CASE "URUS_PA1_PR0_R12_EXT":
                    Volume_URUS_PA1_PR0_R12_EXT;
                    CalcVolLog;
                    bCartdrige:=TRUE;
                    IF bDefaultVol=TRUE nVolume:=550;

                CASE "URUS_PA1_PR0_R12_EXTII":
                    Volume_URUS_PA1_PR0_R12_EXTII;
                    bCartdrige:=FALSE;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=520;

                CASE "HURACAN_PRIM_R12_INT":
                    Volume_HURACAN_PRIM_INT;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=500;

                CASE "HURACAN_PRIM_R12_EXT":
                    Volume_HURACAN_PRIM_R12_EXT;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=500;

                CASE "HURACAN_BC0_R12_INT":
                    Volume_HURACAN_BC0_INT;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=550;

                CASE "HURACAN_BC0_R12_EXT":
                    Volume_URUS_PA1_BC0_R12_EXT;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=550;
                    bCartdrige:=TRUE;

                CASE "HURACAN_BC0_R12_EXTII":
                    Volume_URUS_PA1_BC0_R12_EXTII;
                    bCartdrige:=FALSE;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=550;

                CASE "HURACAN_BC0_R12_PLA":
                    Volume_HURACAN_BC0_R12_PLA;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=500;
                    bCartdrige:=TRUE;

                CASE "HURACAN_BC0_R2_PLAII":
                    Volume_HURACAN_BC0_R12_PLAII;
                    bCartdrige:=FALSE;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=500;

                CASE "URUS_PA2_BC0_INT_2024":
                    Volume_URUS_PA2_BC0_INT;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=550;

                CASE "URUS_PA2_BC0_R12_EXT_2024":
                    Volume_URUS_PA2_BC0_R12_EXT;
                    CalcVolLog;
                    bCartdrige:=TRUE;
                    IF bDefaultVol=TRUE nVolume:=580;

                CASE "URUS_PA2_BC0_R12_EXT_2024II":
                    Volume_URUS_PA2_BC0_R12_EXTII;
                    bCartdrige:=FALSE;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=520;

                CASE "URUS_PA2_PR0_R12_EXT_2024":
                    Volume_URUS_PA2_PR0_R12_EXT;
                    CalcVolLog;
                    bCartdrige:=TRUE;
                    nVolume:=500;

                CASE "URUS_PA2_PR0_R12_EXT_2024II":
                    Volume_URUS_PA2_PR0_R12_EXTII;
                    bCartdrige:=FALSE;
                    CalcVolLog;
                    IF bDefaultVol=TRUE nVolume:=520;

                CASE "URUS_PA1_HOOD_R12_EXT":
                    Volume_URUS_PA1_HOOD_R12_EXT;
                    bCartdrige:=FALSE;
                    CalcVolLog;
                    nVolume:=550;
                    !
                DEFAULT:
                    nVolume:=600;
                    WaitTime 0.5;
                    !
                ENDTEST
                SetTmSignal "goVolumeCalcpreFIFO",nVolume,0.1;
                PntMAPlog " Vol : "+stModNameCalc+" Skid: "+NumToStr(nJobIDnum,0)+
                          " Calcul Vol : "+NumToStr(VolEst,0)+" Color: "+NumToStr(nMaterialnum,0)+".";
                PntMAPlog " ---------------------------";
                SetTmSignal "goJodIDpreFIFO",nJobIDnum,0;
                nLastJobIDnum:=nJobIDnum;
                nLastPrognum:=nProgramnum;
                !delay Head PLC
                WaitTime 0.5;
                !
                PulseDO\PLength:=1.0,doEndCalcPreFIFO;
                WaitTime 0.3;
                WaitUntil doEndCalcPreFIFO=0;
            ENDIF
        ENDIF
        label:
        !
        WaitTime 3;
    ENDPROC

    FUNC string sModelget(num nProgramnum,num nColumn)
        VAR string nTemp;
        VAR string stTemp;
        VAR string stFilePath;
        VAR bool btemp;
        VAR string sDefault:="";

        VAR bool berr;

        stFilePath:=HOME_ROOT+PROGRAMS_DIR+NDX_FILE;
        IF IsFile(stFilePath) THEN
            IF nProgramnum>0 THEN
                stTemp:=IndexLookup(stFilePath,nProgramnum,nColumn);
                IF stTemp<>"" THEN
                    IF nColumn>1 THEN
                        nTemp:=stTemp;
                        RETURN nTemp;
                    ELSE
                        RETURN stTemp;
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        RETURN sDefault;
    ERROR
        IF ERRNO=ERR_CSV_INDEX THEN
            !ErrWrite\I,"Programs number not found in segments.ndx","Calculation volume not done - Default value set";
            RETURN sDefault;
            !PulseDO\High,sdoRobotError;
        ENDIF
    ENDFUNC

    PROC Volume_URUS_PA1_BC0_R12_PLA()
        nVolume:=0;
        nVolumeCalc:=0;
        SetTmSignal "goVolumeCalcpreFIFO",0,0.1;
        BrushTableNo:=(nProgramnum*1000)+nMaterialnum;
        WaitTime 0.2;
        !checking if file is presence in the Brush folder
        BrushPath:=HOME_ROOT+BRUSH_DIR+"Table"+NumToStr(BrushTableNo,0)+bt;
        sizebrush:=FileSize(BrushPath);
        !checking if file is presence in the btrack folder
        IF bFIFOSENSORS=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_02_Sensors");

        ENDIF
        !
        IF bFIFOANTENNA=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_01_Antenna");

        ENDIF
        !
        IF bFIFOSPOILERLIP=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_06_Spoilerlip");

        ENDIF
        !
        IF bFIFOARCHES_R=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_07_Arches");

        ENDIF
        !
        IF bFIFOLOWSPOILER=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_05_Lowspoiler");

        ENDIF
        !
        IF bFIFORBUMPERLP=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_04_RBumperlp");

        ENDIF
        WaitTime 0.2;
        
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=650;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

    PROC Volume_URUS_PA1_BC0_R12_PLAII()
        nVolume:=0;
        nVolumeCalc:=0;
        !
        IF bFIFOFDPANELS=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_09_FDpanels");

        ENDIF
        !
        IF bFIFOFBUMPERLP=TRUE THEN

            CalcVolPMR("Vol_UR_BC0_PLA_08_FBumperlp");

        ENDIF
        WaitTime 0.2;
        
    ERROR
        nVolume:=650;
        errormemory:=TRUE;
        RETURN ;
    ENDPROC

    PROC Volume_URUS_PA1_PR0_INT()
        nVolume:=0;
        nVolumeCalc:=0;
        SetTmSignal "goVolumeCalcpreFIFO",0,0.1;
        BrushTableNo:=(nProgramnum*1000)+nMaterialnum;
        WaitTime 0.2;
        !Checking if files is presence in the Brush folder
        BrushPath:=HOME_ROOT+BRUSH_DIR+"Table"+NumToStr(BrushTableNo,0)+bt;
        sizebrush:=FileSize(BrushPath);
        !
        CalcVolPMR("Vol_UR_BC0_TR_INT1");

        IF RobID=12 THEN

            CalcVolPMR("Vol_UR_BC0_TR_INT2");

        ENDIF
        !
        IF bFIFOOpz1Prog3 OR bFIFOOpz1Prog4 OR bFIFOOpz1Prog5 THEN

            CalcVolPMR("Vol_UR_PR0_FB_INT");
        ELSE
            CalcVolPMR("Vol_UR_PR0_FB_INT");

        ENDIF

        CalcVolPMR("Vol_UR_BC0_EC_INT");

        CalcVolPMR("Vol_UR_BC0_FD_INT1");

        CalcVolPMR("Vol_UR_BC0_FD_INT2");

        CalcVolPMR("Vol_UR_BC0_RD_INT");
        WaitTime 0.2;
        
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=650;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

    PROC Volume_URUS_PA1_PR0_R12_EXT()
        nVolume:=0;
        nVolumeCalc:=0;
        SetTmSignal "goVolumeCalcpreFIFO",0,0.1;
        BrushTableNo:=(nProgramnum*1000)+nMaterialnum;
        WaitTime 0.2;
        !Checking if files is presence in the Brush folder
        BrushPath:=HOME_ROOT+BRUSH_DIR+"Table"+NumToStr(BrushTableNo,0)+bt;
        sizebrush:=FileSize(BrushPath);
        !
        CalcVolPMR("Vol_UR_BC0_FC_Ext");
        IF bFIFOOpz1Prog2 THEN

            CalcVolPMR("Vol_UR_BC0_SuRO1_Ext");

            CalcVolPMR("Vol_UR_BC0_SuRO2_Ext");

        ELSEIF bFIFOOpz1Prog3 THEN

            CalcVolPMR("Vol_UR_BC0_RO1_CFK_Ext");

            CalcVolPMR("Vol_UR_BC0_RO2_CFK_Ext");

        ELSEIF bFIFOOpz1Prog4 THEN

            CalcVolPMR("Vol_UR_BC0_RO1_Ext");

            CalcVolPMR("Vol_UR_BC0_RO2_Ext");

        ELSEIF bFIFOOpz1Prog5 THEN

            CalcVolPMR("Vol_UR_BC0_SuRo1_ext");

            CalcVolPMR("Vol_UR_BC0_SuRo2_ext");
        ELSE
            CalcVolPMR("Vol_UR_BC0_Ro1_ext");

            CalcVolPMR("Vol_UR_BC0_Ro2_ext");

        ENDIF

        CalcVolPMR("Vol_UR_BC0_Ra1_ext");

        CalcVolPMR("Vol_UR_BC0_Ra2_ext");

        IF RobID=13 THEN

            CalcVolPMR("Vol_UR_BC0_TGate1_Ext");
        ELSE
            CalcVolPMR("Vol_UR_BC0_TGate2_Ext");

        ENDIF
        WaitTime 0.2;
        
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=650;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

    PROC Volume_URUS_PA1_PR0_R12_EXTII()
        nVolume:=0;
        nVolumeCalc:=0;
        ! Front Fender / Door
        CalcVolPMR("Vol_UR_BC0_SF_Ext");
        ! Rear Fender / Door
        CalcVolPMR("Vol_UR_PR0_SR_Ext");
        WaitTime 0.2;
        
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=650;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

    PROC Volume_URUS_PA1_BC0_INT()
        nVolume:=0;
        nVolumeCalc:=0;
        SetTmSignal "goVolumeCalcpreFIFO",0,0.1;
        BrushTableNo:=(nProgramnum*1000)+nMaterialnum;
        WaitTime 0.2;
        !checking if file is presence in the Brush folder
        BrushPath:=HOME_ROOT+BRUSH_DIR+"Table"+NumToStr(BrushTableNo,0)+bt;
        sizebrush:=FileSize(BrushPath);
        IF bFIFOOpz1Prog16=FALSE THEN

            CalcVolPMR("Vol_UR_BC0_TR_INT1");

            IF RobID=12 THEN

                CalcVolPMR("Vol_UR_BC0_TR_INT2");

            ENDIF
            IF bFIFOOpz1Prog3 OR bFIFOOpz1Prog4 OR bFIFOOpz1Prog5 THEN

                CalcVolPMR("Vol_UR_BC0_CFKFB_INT");
            ELSE
                CalcVolPMR("Vol_UR_BC0_FB_INT");

            ENDIF

            CalcVolPMR("Vol_UR_BC0_EC_INT");

            CalcVolPMR("Vol_UR_BC0_FD_INT1");

            CalcVolPMR("Vol_UR_BC0_FD_INT2");

            CalcVolPMR("Vol_UR_BC0_RD_INT");

        ELSEIF bFIFOOpz1Prog16=TRUE THEN
            !
            IF bFIFOINT_EC THEN

                CalcVolPMR("Vol_UR_BC0_EC_INT");

            ENDIF
            !
            IF bFIFOINT_BONNET THEN

                CalcVolPMR("Vol_UR_BC0_FB_INT");

            ENDIF
            IF bFIFOINT_EC OR bFIFOINT_BONNET OR bFIFOINT_FDR_LEAF OR bFIFOINT_FDR_ENTRY

            CalcVolPMR("Vol_UR_BC0_FD_INT1");
            CalcVolPMR("Vol_UR_BC0_FD_INT2");

        ENDIF
        !
        IF bFIFOINT_TAILGATE THEN

            CalcVolPMR("Vol_UR_BC0_TR_INT1");
            CalcVolPMR("Vol_UR_BC0_TR_INT2");

        ENDIF
        !
        IF bFIFOINT_FDR_LEAF AND bFIFOINT_FDR_ENTRY THEN

            CalcVolPMR("Vol_UR_BC0_FD_INT2");

        ELSEIF bFIFOINT_FDR_LEAF THEN

            CalcVolPMR("Vol_UR_BC0_FDLEAF_INT2");
        ELSE
            CalcVolPMR("Vol_UR_BC0_FDENTRY_INT2");

        ENDIF
        !
        IF bFIFOINT_RDR_LEAF AND bFIFOINT_RDR_ENTRY THEN

            CalcVolPMR("Vol_UR_BC0_RD_INT");

        ELSEIF bFIFOINT_RDR_LEAF THEN

            CalcVolPMR("Vol_UR_BC0_RDLEAF_INT");

        ELSE
            CalcVolPMR("Vol_UR_BC0_RDENTRY_INT");

        ENDIF
        WaitTime 0.2;
        
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=650;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

    PROC Volume_URUS_PA1_BC0_R12_EXT()
        nVolume:=0;
        nVolumeCalc:=0;
        SetTmSignal "goVolumeCalcpreFIFO",0,0.1;
        BrushTableNo:=(nProgramnum*1000)+nMaterialnum;
        WaitTime 0.2;
        !Checking if files is presence in the Brush folder
        BrushPath:=HOME_ROOT+BRUSH_DIR+"Table"+NumToStr(BrushTableNo,0)+bt;
        sizebrush:=FileSize(BrushPath);
        !
        IF bFIFOOpz1Prog16=FALSE THEN
            IF bFIFOOpz1Prog3 OR bFIFOOpz1Prog4 OR bFIFOOpz1Prog5 THEN

                CalcVolPMR("Vol_UR_BC0_HO1_Ext");

                CalcVolPMR("Vol_UR_BC0_HO2_Ext");
            ELSE
                CalcVolPMR("Vol_UR_BC0_HO1_Ext");

                CalcVolPMR("Vol_UR_BC0_HO2_Ext");

            ENDIF
            !
            CalcVolPMR("Vol_UR_BC0_FC_Ext");
            !
            IF bFIFOOpz1Prog2 THEN

                CalcVolPMR("Vol_UR_BC0_SuRO1_Ext");

                CalcVolPMR("Vol_UR_BC0_SuRO2_Ext");

            ELSEIF bFIFOOpz1Prog3 THEN

                CalcVolPMR("Vol_UR_BC0_RO1_CFK_Ext");

                CalcVolPMR("Vol_UR_BC0_RO2_CFK_Ext");

            ELSEIF bFIFOOpz1Prog4 THEN

                CalcVolPMR("Vol_UR_BC0_RO1_Ext");

                CalcVolPMR("Vol_UR_BC0_RO2_Ext");

            ELSEIF bFIFOOpz1Prog5 THEN

                CalcVolPMR("Vol_UR_BC0_SuRO1_Ext");

                CalcVolPMR("Vol_UR_BC0_SuRO2_Ext");
            ELSE
                CalcVolPMR("Vol_UR_BC0_RO1_Ext");

                CalcVolPMR("Vol_UR_BC0_RO2_Ext");
            ENDIF

            CalcVolPMR("Vol_UR_BC0_RA1_Ext");

            CalcVolPMR("Vol_UR_BC0_RA2_Ext");

            IF RobID=13 THEN

                CalcVolPMR("Vol_UR_GrTgate_Ext");

                CalcVolPMR("Vol_UR_BC0_TGate1_Ext");
            ELSE
                CalcVolPMR("Vol_UR_BC0_TGate2_Ext");
            ENDIF

        ELSEIF bFIFOOpz1Prog16=TRUE THEN

            IF bFIFOOpz3Prog14 THEN

                CalcVolPMR("Vol_UR_BC0_TGate2_Ext");

            ELSEIF bFIFOOpz3Prog1 THEN

                CalcVolPMR("Vol_UR_BC0_HO1_Ext");

                CalcVolPMR("Vol_UR_BC0_HO2_Ext");

                CalcVolPMR("Vol_UR_BC0_SF_Ext_RepHood");

            ELSEIF bFIFOOpz3Prog7 THEN

                CalcVolPMR("Vol_UR_BC0_HO2_Rep_Fender_Ext");

                CalcVolPMR("Vol_UR_BC0_SF_Ext_RepFender");

                CalcVolPMR("Vol_UR_BC0_FC_Ext_Rep");

            ELSEIF bFIFOOpz3Prog15 THEN

                CalcVolPMR("Vol_UR_BC0_FC_Ext_Rep");

            ELSEIF bFIFOOpz3Prog3 THEN

                CalcVolPMR("Vol_UR_BC0_SuRO1_Ext");

                CalcVolPMR("Vol_UR_BC0_SuRO2_Ext");

            ELSEIF bFIFOOpz3Prog2 THEN

                CalcVolPMR("Vol_UR_BC0_RO1_Ext");

                CalcVolPMR("Vol_UR_BC0_RO2_Ext");

            ELSEIF bFIFOOpz3Prog5 THEN

                CalcVolPMR("Vol_UR_BC0_RA1_Ext");

                CalcVolPMR("Vol_UR_BC0_RA2_Ext");

            ELSEIF bFIFOOpz3Prog14 THEN

                CalcVolPMR("Vol_UR_BC0_Ro1_ext_RepTgate");

                CalcVolPMR("Vol_UR_BC0_Ro2_Ext_RepTgate");

            ELSEIF bFIFOOpz3Prog2 OR bFIFOOpz3Prog3 THEN

                CalcVolPMR("Vol_UR_BC0_Ra1_Ext_Roof_Rep");

                CalcVolPMR("Vol_UR_BC0_Ra2_Ext_Roof_Rep");

            ENDIF
        ENDIF
        WaitTime 0.2;
        
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=650;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

    PROC Volume_URUS_PA1_BC0_R12_EXTII()
        nVolume:=0;
        nVolumeCalc:=0;
        !
        IF bFIFOOpz1Prog16=TRUE THEN
            IF bFIFOOpz3Prog9 THEN

                CalcVolPMR("Vol_UR_BC0_SF_Ext");

            ELSEIF bFIFOOpz3Prog7=TRUE AND bFIFOOpz3Prog11=FALSE THEN

                CalcVolPMR("Vol_UR_BC0_SF_Ext_RepFender");

            ELSEIF bFIFOOpz3Prog1=TRUE AND bFIFOOpz3Prog11=FALSE THEN

                CalcVolPMR("Vol_UR_BC0_SF_Ext_RepHood");

            ELSEIF bFIFOOpz3Prog11=TRUE AND (bFIFOOpz3Prog5=FALSE AND bFIFOOpz3Prog1=FALSE) THEN

                CalcVolPMR("Vol_UR_BC0_SF_Ext_RepRear");

            ELSEIF bFIFOOpz3Prog11=TRUE AND bFIFOOpz3Prog1=TRUE THEN

                CalcVolPMR("Vol_UR_BC0_SF_Ext_RepHood_Rear");

            ELSEIF bFIFOOpz3Prog7=TRUE AND bFIFOOpz3Prog11=TRUE THEN

                CalcVolPMR("Vol_UR_BC0_SF_Ext");

            ELSEIF bFIFOOpz3Prog11 THEN

                CalcVolPMR("Vol_UR_BC0_SR_Ext");

            ELSEIF bFIFOOpz3Prog9=TRUE AND bFIFOOpz3Prog5=FALSE THEN

                CalcVolPMR("Vol_UR_BC0_SR_Ext_RepSF");

            ELSEIF bFIFOOpz3Prog5=TRUE AND bFIFOOpz3Prog9=FALSE THEN

                CalcVolPMR("Vol_UR_BC0_SR_Ext_RepRail");

            ELSEIF bFIFOOpz3Prog5=TRUE AND bFIFOOpz3Prog9=TRUE THEN

                CalcVolPMR("Vol_UR_BC0_SR_Ext");

            ENDIF
        ELSEIF bFIFOOpz1Prog16=FALSE THEN
            !Front Fender/Door
            CalcVolPMR("Vol_UR_BC0_SF_Ext");
            !Rear Fender/Door
            CalcVolPMR("Vol_UR_BC0_SR_Ext");
            !
        ENDIF
         WaitTime 0.2;
         
    ERROR
        nVolume:=650;
        errormemory:=TRUE;
        RETURN ;
    ENDPROC

    PROC Volume_HURACAN_BC0_R12_PLA()
        nVolume:=0;
