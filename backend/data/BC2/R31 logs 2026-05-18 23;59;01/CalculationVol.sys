        bFIFOSIDEFINS:=BitCheckDnum(dnTemp2,1);
        bFIFOFUELCAPS:=BitCheckDnum(dnTemp2,2);
        bFIFOLHMIRROR:=BitCheckDnum(dnTemp2,3);
        bFIFODIAPASONS:=BitCheckDnum(dnTemp2,4);
        bFIFORHMIRROR:=BitCheckDnum(dnTemp2,5);
        bFIFOFBUMPERUP:=BitCheckDnum(dnTemp2,6);
        bFIFOARCHES_L:=BitCheckDnum(dnTemp2,7);
        bFIFORDPANELS:=BitCheckDnum(dnTemp2,8);
        bFIFOSPOILER:=BitCheckDnum(dnTemp2,9);
        bFIFORBUMPERUP:=BitCheckDnum(dnTemp2,10);
        bFIFOLHDHANDLES:=BitCheckDnum(dnTemp2,11);
        bFIFOOpz2Prog12:=BitCheckDnum(dnTemp2,12);
        bFIFOOpz2Prog13:=BitCheckDnum(dnTemp2,13);
        bFIFOOpz2Prog14:=BitCheckDnum(dnTemp2,14);
        bFIFOOpz2Prog15:=BitCheckDnum(dnTemp2,15);
        bFIFOOpz2Prog16:=BitCheckDnum(dnTemp2,16);
        !Hur PLA
