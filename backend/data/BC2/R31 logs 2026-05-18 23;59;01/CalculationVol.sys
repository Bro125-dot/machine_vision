        bFIFOOpz2Prog4:=BitCheckDnum(dnTemp2,4);
        bFIFOOpz2Prog5:=BitCheckDnum(dnTemp2,5);
        bFIFOOpz2Prog6:=BitCheckDnum(dnTemp2,6);
        bFIFOOpz2Prog7:=BitCheckDnum(dnTemp2,7);
        bFIFOOpz2Prog8:=BitCheckDnum(dnTemp2,8);
        bFIFOOpz2Prog9:=BitCheckDnum(dnTemp2,9);
        bFIFO_CARBONTAIL:=BitCheckDnum(dnTemp2,10);
        bFIFO_UPPERSP:=BitCheckDnum(dnTemp2,11);
        bFIFOOpz2Prog12:=BitCheckDnum(dnTemp2,12);
        bFIFOOpz2Prog13:=BitCheckDnum(dnTemp2,13);
        bFIFO_UPPERSP_CFK:=BitCheckDnum(dnTemp2,14);
        bFIFOOpz2Prog15:=BitCheckDnum(dnTemp2,15);
        bFIFOOpz2Prog16:=BitCheckDnum(dnTemp2,16);
    ENDPROC

    PROC Opz3ProgPreFIFO()
        !Variant Plastic URUS right side

        VAR dnum dnTemp3;

        dnTemp3:=NumToDnum(nProgOpz3num);
        !dnTemp:=NumToDnum(...);

        bFIFORHDHANDLES:=BitCheckDnum(dnTemp3,1);
        bFIFOSPOILERLIP:=BitCheckDnum(dnTemp3,2);
