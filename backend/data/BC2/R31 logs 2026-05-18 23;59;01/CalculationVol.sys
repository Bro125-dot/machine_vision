        bFIFO_ROCKER_COVER_CFK:=BitCheckDnum(dnTemp3,10);
        bFIFO_FBUMPER:=BitCheckDnum(dnTemp3,11);
        bFIFO_RBUMPER:=BitCheckDnum(dnTemp3,12);
        bFIFO_UP_SPOILER:=BitCheckDnum(dnTemp3,13);
        bFIFO_UP_SPOILER_CFK:=BitCheckDnum(dnTemp3,14);
        bFIFOOpz3Prog15:=BitCheckDnum(dnTemp3,15);
        bFIFOOpz3Prog16:=BitCheckDnum(dnTemp3,16);
        !Spare
        bFIFOOpz3Prog1:=BitCheckDnum(dnTemp3,1);
        bFIFOOpz3Prog2:=BitCheckDnum(dnTemp3,2);
        bFIFOOpz3Prog3:=BitCheckDnum(dnTemp3,3);
        bFIFOOpz3Prog4:=BitCheckDnum(dnTemp3,4);
        bFIFOOpz3Prog5:=BitCheckDnum(dnTemp3,5);
        bFIFOOpz3Prog6:=BitCheckDnum(dnTemp3,6);
        bFIFOOpz3Prog7:=BitCheckDnum(dnTemp3,7);
        bFIFOOpz3Prog8:=BitCheckDnum(dnTemp3,8);
        bFIFOOpz3Prog9:=BitCheckDnum(dnTemp3,9);
        bFIFOOpz3Prog10:=BitCheckDnum(dnTemp3,10);
        bFIFOOpz3Prog11:=BitCheckDnum(dnTemp3,11);
        bFIFOOpz3Prog12:=BitCheckDnum(dnTemp3,12);
        bFIFOOpz3Prog13:=BitCheckDnum(dnTemp3,13);
        bFIFOOpz3Prog14:=BitCheckDnum(dnTemp3,14);
        bFIFOOpz3Prog15:=BitCheckDnum(dnTemp3,15);
        bFIFOOpz3Prog16:=BitCheckDnum(dnTemp3,16);
    ENDPROC

    PROC CalcVolPMR(string stRoutName)
        !
        FilePath:=HOME_ROOT+BTRACK_DIR+stRoutName+trk;
        size:=FileSize(FilePath);
        nVolumeCalc:=PntBrushTrackFileGet(stRoutName,BrushTableNo);
        nVolume:=nVolume+nVolumeCalc;
        !
    ERROR
        IF ERRNO=ERR_FILEACC THEN
            nVolume:=600;
            errormemory:=TRUE;
            RETURN ;
        ENDIF
    ENDPROC

    LOCAL TRAP tpirErrInJob
        IF InModule=1 THEN
            SetDO doErrInJob,1;
            WaitTime 0.1;
        ENDIF
        !
    ENDTRAP

    LOCAL TRAP tpStopGunBellCleaner
        SetDO A1AirImp,0;
        SetDO A1AirRing,0;
        SetDO A1AirImp,0;
    ENDTRAP

    LOCAL TRAP tpProgramInfo
        stRobotName:="R31";
        SetTmSignal "goConsuption",0,0;
        SetTmSignal "goTcJob",0,0;
        SetTmSignal "goBrushTableUsed",0,0;
        IF doErrInJob=1 SetTmSignal "doErrInJob",0,0;
        ClkReset clkCycleTime;
        ClkStart clkCycleTime;
        stValve:="Paint Valve: "+NumToStr(nSelMtrlOption3,0)+".";
        ErrWrite\I,stRobotName+" Program Info Skid n: "+NumToStr(nSelJobID,0)+".",
            "Loaded program: "+NumToStr(nSelProgIndex,0)+". Material: "+NumToStr(nSelMtrlIndex,0)+"."
            \RL2:=stValve
            \RL3:=" + VolumeFilled: "+NumToStr(nFluidCalcul,0)+".";
    ENDTRAP

    LOCAL TRAP tpNoMorePiantPMR
        !
        ! Scope: Close the last valve used when the paint is loaded
        !        Open the last valve used e start production
        !        Robot Stop because of the sensor pressure
        !
        TEST nA1FluidDevNo
        CASE 1:
            SetGO A1Col1,0;
            SetTmSignal "A1Pump1PSInLimEn",0,0.1;
            SetTmSignal "A1Pump1PSOutLimEn",0,0.1;
        CASE 2:
            SetGO A1Col2,0;
            SetTmSignal "A1Pump2PSInLimEn",0,0.1;
            SetTmSignal "A1Pump2PSOutLimEn",0,0.1;
        DEFAULT:
            ErrWrite\I,"No need to close a color valve","";
        ENDTEST
        !
        bLastValve:=TRUE;
        !
    ENDTRAP

ENDMODULE
